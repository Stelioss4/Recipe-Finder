@page "/profile"
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Identity.UI.Services
@using Microsoft.EntityFrameworkCore
@using RecipeFinder_WebApp.Data
@using Recipe_Finder

@inject IEmailSender EmailSender
@inject SignInManager<ApplicationUser> SignInManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ScrapperService Scrap
@inject NavigationManager Navigation
@inject DataService DataService
@inject UserManager<ApplicationUser> _userManager
@inject WeeklyPlanService _weeklyPlan
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory
@inject FavoriteService _favorite
@inject Blazored.Toast.Services.IToastService ToastService

<h3>User Profile</h3>
<div class="container mt-5">
    @if (user != null)
    {
        <p>Welcome, @user.Name!</p>
        <br />

        <div class="row mb-4">
            <div class="col-md-8 d-flex gap-2 flex-wrap">
                <!-- Popup Buttons -->
                <button class="btn btn-primary" @onclick="TogglePopupFavorites">Favorite Recipes</button>
                <button class="btn btn-secondary" @onclick="TogglePopupShoppingList">Shopping List</button>
                <button class="btn btn-primary" @onclick="TogglePopupWeeklyPlan">Weekly Meal Plan</button>
                <button class="btn btn-primary" @onclick="TogglePopupSearchBox">Search Recipes</button>
            </div>
        </div>

       

        @if (showSearchBoxPopup)
        {
            <SearchBox searchQuery="@searchQuery" OnSearch="HandleSearch" />

            @if (recipes.Count > 0)
            {
                <RecipeOutput recipes="recipes" RemoveRecipeButton="false"></RecipeOutput>
            }

        }

        <!-- Favorite Recipes Popup -->
        @if (showFavoritesPopup)
        {
            <div class="popup">
                <div class="popup-content">
                    @if (user.FavoriteRecipes != null && user.FavoriteRecipes.Count > 0)
                    {
                        <RecipeOutput recipes="user.FavoriteRecipes" AddRecipeButton="false" OnFavoriteRemoved="RemoveFavoriteFromProfile" />
                    }
                    else
                    {
                        <p>You don't have any favorite recipes yet.</p>
                        <button class="btn btn-outline-primary" @onclick="NavigateToHome">Search recipes to Add!</button>
                    }
                </div>
            </div>
        }

        <!-- Shopping List Popup -->
        @if (showShoppingListPopup)
        {
            if (user.ShoppingList != null && user.ShoppingList.Count > 0)
            {
                <ShoppingListOutput ShoppingList="user.ShoppingList" OnShoppingListChanged="UpdateShoppingList" />
            }
            else
            {
                <p>Your Shopping list is empty!</p>
            }
        }

        <!-- Weekly Plan Popup -->
        @if (showWeeklyPlanPopup)
        {
            <div class="popup">
                <div class="popup-content shadow rounded p-4">

                    <h4 class="text-center mb-4">Weekly Plan</h4>

                    @if (appUser.User.WeeklyPlan != null && appUser.User.WeeklyPlan.Count > 0)
                    {
                        @for (int i = 0; i < appUser.User.WeeklyPlan.Count; i++)
                        {
                            var rec = appUser.User.WeeklyPlan[i];
                            var day = daysOfWeek[i];

                            <div class="why-box border rounded shadow-sm p-3 mb-3">
                                <h5 class="mb-3 text-primary">@day</h5>

                                <div class="d-flex align-items-center">
                                    <input type="checkbox" class="form-check-input me-3" />

                                    @if (rec.Image != null && rec.Image.Length > 0)
                                    {
                                        <img src="data:image/png;base64,@Convert.ToBase64String(rec.Image)"
                                             style="width: 60px; height: 60px; object-fit: cover; border-radius: 10px;"
                                             class="me-3 shadow-sm" />
                                    }

                                    <div class="flex-grow-1">
                                        <h6 class="mb-2">@rec.RecipeName</h6>
                                        <a href="#" class="btn btn-outline-primary btn-sm rounded-pill px-3" @onclick="() => NavigateToRecipeDetails(rec.Url)">
                                            View Recipe
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }

                        <p class="mt-4 text-center text-muted">
                            Your weekly plan was created on <strong>@appUser.User.LastWeeklyPlanDate</strong>
                        </p>

                        <div class="text-center mt-3">
                            <div class="d-inline-flex" style="align-items:stretch; overflow:hidden; border-radius:50rem;">

                                <button class="btn btn-secondary px-4 shadow-sm"
                                        style="border-radius:50rem 0 0 50rem;"
                                        @onclick="ForceNewPlan" disabled="@Loading">
                                    @if (Loading)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                        <span>New Plan...</span>
                                    }
                                    else
                                    {
                                        <span>New Plan</span>
                                    }
                                </button>

                                <button class="btn btn-secondary"
                                        style="border-radius:0 50rem 50rem 0; padding:0 12px;"
                                        @onclick="ToggleDropdown">
                                    ▼
                                </button>

                            </div>
                        </div>

                        @if (isDropdownOpen && user.UserPreferences != null)
                        {
                            <div>
                                <div class="border rounded p-3 mb-4 shadow-sm">
                                    <h5 class="mb-3 text-center">Plan Preferences</h5>

                                    <div class="mb-3">
                                        <label class="form-label"><strong>Maximum Calories per Recipe</strong></label>
                                        <input type="number" class="form-control" @bind="user.UserPreferences.MaxCaloriesPerRecipe" min="0" />
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label"><strong>Maximum Preparation Time in Minutes</strong></label>
                                        <input type="number" class="form-control" @bind="user.UserPreferences.MaxPreparationTimeInMinutes" min="0" />
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label"><strong>Favorite Recipes in Weekly Plan</strong></label>
                                        <input type="number" class="form-control" @bind="user.UserPreferences.PreferredFavoriteRecipesPerWeek" min="0" max="7" />
                                    </div>
                                </div>
                                <div class="text-center">
                                    <p class="mb-3">No weekly plan generated yet.</p>
                                    <button class="btn btn-outline-primary rounded-pill px-4 shadow-sm" @onclick="CreateWeeklyPlan" disabled="@Loading">
                                        @if (Loading)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2"></span>

                                            <span>Plan Generating...</span>
                                        }
                                        else
                                        {
                                            <span>Generate New Plan</span>
                                        }
                                    </button>
                                </div>
                            </div>
                        }
                    }
                    else if (user.FavoriteRecipes.Count <= Constants.LIMIT_DAYS)
                    {
                        <div class="text-center">
                            <p class="mb-3">You need more favorite recipes to generate a weekly plan.</p>
                            <button class="btn btn-outline-primary rounded-pill px-4 shadow-sm" @onclick="NavigateToHome">
                                Search recipes to Add!
                            </button>
                        </div>
                    }
                    else if (user.UserPreferences != null)
                    {

                        <div class="border rounded p-3 mb-4 shadow-sm">
                            <h5 class="mb-3 text-center">Plan Preferences</h5>

                            <div class="mb-3">
                                <label class="form-label"><strong>Maximum Calories per Recipe</strong></label>
                                <input type="number" class="form-control" @bind="user.UserPreferences.MaxCaloriesPerRecipe" min="0" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label"><strong>Maximum Preparation Time in Minutes</strong></label>
                                <input type="number" class="form-control" @bind="user.UserPreferences.MaxPreparationTimeInMinutes" min="0" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label"><strong>Favorite Recipes in Weekly Plan</strong></label>
                                <input type="number" class="form-control" @bind="user.UserPreferences.PreferredFavoriteRecipesPerWeek" min="0" max="7" />
                            </div>
                        </div>
                        <div class="text-center">
                            <p class="mb-3">No weekly plan generated yet.</p>
                            <button class="btn btn-outline-primary rounded-pill px-4 shadow-sm" @onclick="CreateWeeklyPlan" disabled="@Loading">
                                @if (Loading)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>

                                    <span>Plan Generating...</span>
                                }
                                else
                                {
                                    <span>Generate Weekly Plan</span>
                                }
                            </button>
                        </div>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <p>Loading user profile...</p>
    }
</div>

@code {
    public User user { get; set; } = new User();
    private ApplicationUser appUser { get; set; } = new();
    private List<Recipe> weeklyPlan { get; set; } = new();
    private bool showWeeklyPlanPopup { get; set; } = false;
    private bool showFavoritesPopup { get; set; } = false;
    private bool showShoppingListPopup { get; set; } = false;
    private bool showSearchBoxPopup { get; set; } = false;
    private readonly string[] daysOfWeek = { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday" };
    private bool Loading = false;
    private bool weeklyPlanExpiredToastShown = false;
    private List<Recipe> recipes { get; set; } = new List<Recipe>();
    private string searchQuery { get; set; } = string.Empty;
    private bool isDropdownOpen = false;

    protected override async Task OnInitializedAsync()
    {
        await Init();
    }

    protected async Task Init()
    {
        appUser = await DataService.GetAuthenticatedUserAsync();

        if (appUser == null)
        {
            await SignInManager.SignOutAsync();
            Navigation.NavigateTo("Account/LogIn");
            return;
        }

        appUser.User = await DataService.GetUserByIdAsync();

        if (appUser.User == null)
        {
            await SignInManager.SignOutAsync();
            Navigation.NavigateTo("Account/LogIn");
            return;
        }

        appUser.User.ShoppingList =
            await _favorite.GetShoppingListAsync()
            ?? new List<Ingredient>();

        appUser.User.UserPreferences =
            await DataService.GetUsersPreferencesAsync();

        await CheckWeeklyPlanExpirationAsync();

        await _favorite.ReloadFavorites();

        user = appUser.User;
    }

    private async Task CheckWeeklyPlanExpirationAsync()
    {
        if (appUser?.User?.LastWeeklyPlanDate == null)
            return;

        var lastWeeklyPlanDate = await _weeklyPlan.CheckWeeklyPlanDate();

        if (lastWeeklyPlanDate == null)
            return;

        appUser.User.LastWeeklyPlanDate = lastWeeklyPlanDate;

        var daysSinceLastPlan =
            (DateTime.Now - lastWeeklyPlanDate.Value).TotalDays;

        if (daysSinceLastPlan < Constants.WEEK_DAY_NUM)
            return;

        appUser.User.WeeklyPlan ??= new List<Recipe>();

        appUser.User.WeeklyPlan.Clear();
        appUser.User.LastWeeklyPlanDate = null;

        await _weeklyPlan.ClearExpiredWeeklyPlanAsync();

        if (!weeklyPlanExpiredToastShown)
        {
            ToastService.ShowSuccess(
                "Your weekly plan has expired. You can now create a new one!");

            weeklyPlanExpiredToastShown = true;

            await EmailSender.SendEmailAsync(
                appUser.Email!,
                "Weekly Plan Expired",
                "Your weekly meal plan has expired. Please log in to your profile to create a new one.");
        }
    }

    private Task UpdateShoppingList(Ingredient ingredient)
    {
        if (user?.ShoppingList == null)
        {
            return Task.CompletedTask;
        }

        var existingIngredient = user.ShoppingList
            .FirstOrDefault(i => i.Id == ingredient.Id);

        if (existingIngredient != null)
        {
            user.ShoppingList.Remove(existingIngredient);
        }

        StateHasChanged();

        return Task.CompletedTask;
    }

    private void TogglePopupFavorites()
    {
        showFavoritesPopup = !showFavoritesPopup;
        if (showFavoritesPopup)
        {
            showWeeklyPlanPopup = false;
            showShoppingListPopup = false;
            showSearchBoxPopup = false;
        }
    }

    private Task RemoveFavoriteFromProfile(Recipe recipe)
    {
        user.FavoriteRecipes.RemoveAll(r => r.Id == recipe.Id);

        StateHasChanged();

        return Task.CompletedTask;
    }

    private async Task TogglePopupWeeklyPlan()
    {
        showWeeklyPlanPopup = !showWeeklyPlanPopup;

        if (showWeeklyPlanPopup)
        {
            user.WeeklyPlan = await _weeklyPlan.GetWeeklyPlanAsync(user.Id);

            EnsureUserPreferences();

            showFavoritesPopup = false;
            showShoppingListPopup = false;
            showSearchBoxPopup = false;
        }
    }

    private void TogglePopupShoppingList()
    {
        showShoppingListPopup = !showShoppingListPopup;
        if (showShoppingListPopup)
        {
            showFavoritesPopup = false;
            showWeeklyPlanPopup = false;
            showSearchBoxPopup = false;
        }
    }

    private void TogglePopupSearchBox()
    {
        showSearchBoxPopup = !showSearchBoxPopup;
        if (showSearchBoxPopup)
        {
            showFavoritesPopup = false;
            showWeeklyPlanPopup = false;
            showShoppingListPopup = false;
        }
    }

    private async Task CreateWeeklyPlan()
    {
        Loading = true;

        try
        {
            user.WeeklyPlan = await _weeklyPlan.GenerateSmartWeeklyPlanAsync(
                user.UserPreferences.MaxCaloriesPerRecipe,
                user.UserPreferences.MaxPreparationTimeInMinutes,
                user.UserPreferences.PreferredFavoriteRecipesPerWeek);

            user.LastWeeklyPlanDate = DateTime.Now;

            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            Loading = false;
        }
    }

    private async Task ForceNewPlan()
    {
        Loading = true;

        try
        {
            user.UserPreferences = await DataService.GetUsersPreferencesAsync();

            user.WeeklyPlan = await _weeklyPlan.GenerateSmartWeeklyPlanAsync(
                user.UserPreferences.MaxCaloriesPerRecipe,
                user.UserPreferences.MaxPreparationTimeInMinutes,
                user.UserPreferences.PreferredFavoriteRecipesPerWeek);

            await Init();
            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            Loading = false;
        }
    }

    private void NavigateToRecipeDetails(string recipeUrl)
    {
        Navigation.NavigateTo($"/recipeDetails?url={Uri.EscapeDataString(recipeUrl)}");
    }

    private void NavigateToHome()
    {
        Navigation.NavigateTo("/");
    }

    private void OnShoppingListAdded(Ingredient ingredient)
    {
        user.ShoppingList.Add(ingredient);
        StateHasChanged();
    }

    private async Task HandleSearch(string term)
    {
        searchQuery = term;
        recipes = await Scrap.ScrapeCKRecipes(term);
    }

    private void EnsureUserPreferences()
    {
        if (user != null && user.UserPreferences == null)
        {
            user.UserPreferences = new UserPreferences
            {
                UserId = user.Id
            };
        }
    }

    private void ToggleDropdown()
    {
        EnsureUserPreferences();
        isDropdownOpen = !isDropdownOpen;
    }

}