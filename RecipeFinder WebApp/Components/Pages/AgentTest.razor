@page "/agent-test"
@using RecipeFinder_WebApp.Data.AI
@using RecipeFinder_WebApp.Data.AI.Models
@inject RecipeAgentService RecipeAgentService
@inject OpenRouterService OpenRouterService

<button class="btn btn-primary" @onclick="TestOpenRouter">
    Test AI
</button>

@if (!string.IsNullOrWhiteSpace(_aiResponse))
{
    <p>@_aiResponse</p>
}


@code {
    private List<RecipeAgentDto> _recipes = new List<RecipeAgentDto>();
    private string _status = "Not started";
    private string _aiResponse = string.Empty;

    private async Task TestOpenRouter()
    {
        _aiResponse = await OpenRouterService.SendMessageAsync(
            "Say hello from the Recipe Finder AI agent.");
    }
}